{
  "$schema": "../../../platform/schemas/agent-package.v1.schema.json",
  "package": {
    "id": "damage-handler",
    "version": "0.2.0",
    "industry": "insurance",
    "useCase": "p-and-c-auto-claims",
    "schemaVersion": "v1",
    "signedBy": "anand-track-stub",
    "registeredIn": "agent-365://adp-v1",
    "compiledAt": "2026-05-27T00:00:00Z",
    "stage": "Damage & Estimation",
    "stageOrder": 2
  },
  "digitalWorker": {
    "id": "dw.damage-handler",
    "name": "Damage Handler",
    "description": "Owns damage assessment for triaged P&C auto claims: categorization, repair-cost estimation, total-loss screening, and shop routing. Picks up where FNOL Handler hands off.",
    "entraAgentId": null,
    "stateStore": {
      "kind": "in-memory-stub",
      "containerName": "dw-damage-handler-state",
      "partitionKey": "/subjectId"
    },
    "schemaBinding": {
      "primaryEntity": {
        "factTable": "fact_claims",
        "factSubjectKey": "claim_number",
        "factForeignKey": "policyholder_id",
        "factDateColumn": "incident_date",
        "factDescColumns": [
          "incident_type",
          "severity_hint",
          "state",
          "channel"
        ],
        "dimTable": "dim_policyholder",
        "dimKeyColumn": "policyholder_id",
        "dimDisplayColumns": [
          "first_name",
          "last_name",
          "policy_number",
          "state",
          "city"
        ],
        "entitySemantics": "acl:Claim"
      },
      "secondaryEntity": {
        "factTable": "fact_claims",
        "factSubjectKey": "claim_number",
        "factForeignKey": "vin",
        "factDateColumn": "incident_date",
        "factDescColumns": [
          "incident_type",
          "severity_hint",
          "state"
        ],
        "dimTable": "dim_vehicle",
        "dimKeyColumn": "vin",
        "dimDisplayColumns": [
          "year",
          "make",
          "model"
        ],
        "entitySemantics": "acl:Vehicle"
      },
      "similarityFilters": [
        "incident_type",
        "state"
      ]
    },
    "capabilities": [
      "damage-intake",
      "damage-categorization",
      "repair-estimation",
      "shop-routing"
    ],
    "agentRefs": [
      "agent.damage-intake",
      "agent.damage-categorize",
      "agent.repair-estimate",
      "agent.shop-routing"
    ],
    "slos": [
      {
        "metric": "categorization_latency_p90_minutes",
        "target": 5,
        "comparator": "<=",
        "window": "P30D"
      },
      {
        "metric": "estimate_band_drift_pct",
        "target": 0.2,
        "comparator": "<=",
        "window": "P30D"
      },
      {
        "metric": "shop_routing_acceptance_rate",
        "target": 0.85,
        "comparator": ">=",
        "window": "P30D"
      }
    ],
    "orchestration": {
      "strategy": "hybrid",
      "stepFormation": "hybrid",
      "boundedReasoningZones": [
        {
          "zoneId": "zone.categorize-reasoning",
          "allowedAgents": [
            "agent.damage-categorize"
          ],
          "maxSteps": 3,
          "returnPoint": "step.repair-estimation"
        }
      ],
      "invariants": [
        {
          "id": "inv.category-before-estimate",
          "description": "Repair estimation may not begin before a damage category is committed.",
          "ruleExpression": "claim.damageCategory != null"
        },
        {
          "id": "inv.total-loss-no-shop-routing",
          "description": "If totalLossSuspect=true, the shop-routing step must report status=needs-human-review (do not auto-route to a repair shop).",
          "ruleExpression": "if claim.totalLossSuspect then step.shop_routing.status == 'needs-human-review'"
        },
        {
          "id": "inv.structural-requires-tier1",
          "description": "Structural damage may only route to a Tier-1 (DRP) shop.",
          "ruleExpression": "if claim.damageCategory == 'structural' then assignment.shopTier == 'tier-1'"
        }
      ],
      "hitlGates": [
        {
          "gateId": "gate.low-confidence-category",
          "trigger": "step.damage_categorization.confidence < 0.6",
          "surface": "operator-console"
        },
        {
          "gateId": "gate.total-loss-suspect",
          "trigger": "step.damage_categorization.totalLossSuspect == true",
          "surface": "operator-console"
        }
      ]
    }
  },
  "agents": [
    {
      "id": "agent.damage-intake",
      "kind": "prompt-agent",
      "capability": "damage-intake",
      "systemPrompt": "You are the Damage Intake Agent. Pull together the claim record, vehicle metadata, FNOL triage outputs, and any attached damage report (descriptions, photo count, shop preliminary estimate if present). If the record carries an evidenceAssessment field, it is an objective GPT-4o vision description of the member's submitted damage photos, produced at intake: treat it as primary visual evidence. Produce a structured DamageReport object with: incidentType, photoCount (from evidencePhotoCount when present), narrativeSummary, visionSummary (condensed from evidenceAssessment, or null), partsAffected (prefer areas the vision assessment names; fall back to the narrative), drivability, attachedShopEstimate (nullable). State confidence per field; raise field confidence where vision and narrative agree, lower it where they disagree, and say which. Flag missing data explicitly. Do not categorize damage at this step — that is the next agent's job.",
      "skillRefs": [
        "skill.damage-intake-parsing",
        "skill.parts-tagging"
      ],
      "ontologyBinding": [
        "Claim",
        "Vehicle",
        "DamageReport"
      ],
      "confidenceCalibration": {
        "lowThreshold": 0.4,
        "highThreshold": 0.85,
        "divergenceDetection": false
      },
      "foundryModel": "gpt-4o",
      "deploymentTarget": "foundry-agent-service"
    },
    {
      "id": "agent.damage-categorize",
      "kind": "workflow-agent",
      "capability": "damage-categorization",
      "systemPrompt": "You are the Damage Categorization Agent. Read the DamageReport, the vehicle from dim_vehicle, and the prior similar-claims pattern from Fabric IQ. Assign one of: cosmetic, functional, structural, total-loss-suspect. Apply [[PAC-DAMAGE-001]] and the total-loss rules in [[PAC-TOTAL-LOSS-001]]. When the claim carries an evidenceAssessment (the objective vision description of the member's photos), ground the category primarily in what the photos show: the areas and apparent severity it describes outrank the member's own wording. State explicitly whether the photos corroborate the narrative. If the vision assessment and the narrative point to categories more than one tier apart, or the assessment notes the images are unclear or possibly not genuine damage, flag low confidence and route to HITL. With no photos, categorize from the narrative alone and say the category is narrative-only. Cite the specific evidence either way.",
      "skillRefs": [
        "skill.damage-categorize",
        "skill.total-loss-screen"
      ],
      "ontologyBinding": [
        "DamageReport",
        "Vehicle",
        "DamageCategory"
      ],
      "confidenceCalibration": {
        "lowThreshold": 0.6,
        "highThreshold": 0.88,
        "divergenceDetection": true
      },
      "foundryModel": "gpt-4o",
      "deploymentTarget": "foundry-agent-service"
    },
    {
      "id": "agent.repair-estimate",
      "kind": "workflow-agent",
      "capability": "repair-estimation",
      "systemPrompt": "You are the Repair Estimate Agent. Given the damage category, vehicle class (derive from make/model/year), and policyholder state, produce an estimateLow / estimateHigh dollar band per [[PAC-DAMAGE-002]]. Apply the state labor-rate multiplier to the upper bound. When the claim carries an evidenceAssessment (the vision description of the member's photos), use it to position the point estimate inside the band: fewer or smaller visible damage areas pull toward estimateLow, more panels or apparent structural involvement pull toward estimateHigh, and you must state in one sentence how the photo evidence moved the figure. Photo-corroborated estimates earn higher confidence than narrative-only ones; say which kind this is. Use the Fabric IQ similar-claims population to calibrate confidence — if fewer than 3 prior claims match, drop confidence. If the high end of your estimate crosses 75% of ACV, escalate to total-loss-suspect even if the category was 'structural'.",
      "skillRefs": [
        "skill.repair-band-lookup",
        "skill.acv-threshold-check"
      ],
      "ontologyBinding": [
        "DamageCategory",
        "Vehicle",
        "RepairEstimate"
      ],
      "confidenceCalibration": {
        "lowThreshold": 0.55,
        "highThreshold": 0.9,
        "divergenceDetection": true
      },
      "foundryModel": "gpt-4o",
      "deploymentTarget": "foundry-agent-service"
    },
    {
      "id": "agent.shop-routing",
      "kind": "workflow-agent",
      "capability": "shop-routing",
      "systemPrompt": "You are the Shop Routing Agent. Given the damage category, vehicle make, policyholder state, and the network-shop directory, pick one shop per [[PAC-SHOP-001]]. Structural damage must route Tier-1 only. Premium/EV makes restrict to OEM-certified Tier-1. Prefer in-state shops with lowest current load. Emit shopId, shopTier, routingReason, estimatedStartDate. If only a Tier-3 path is available, or if the lowest-load shop is over 75% capacity, route to HITL with status=needs-human-review.",
      "skillRefs": [
        "skill.shop-match",
        "skill.shop-capacity-balance"
      ],
      "ontologyBinding": [
        "DamageCategory",
        "Vehicle",
        "RepairShop",
        "ShopAssignment"
      ],
      "confidenceCalibration": {
        "lowThreshold": 0.55,
        "highThreshold": 0.9,
        "divergenceDetection": false
      },
      "foundryModel": "gpt-4o",
      "deploymentTarget": "foundry-agent-service"
    }
  ],
  "skills": [
    {
      "id": "skill.damage-intake-parsing",
      "name": "Damage Intake Parsing",
      "skillFile": "skills/damage-intake-parsing/SKILL.md",
      "domain": "insurance/auto/damage"
    },
    {
      "id": "skill.parts-tagging",
      "name": "Affected-Parts Tagging",
      "skillFile": "skills/parts-tagging/SKILL.md",
      "domain": "insurance/auto/damage"
    },
    {
      "id": "skill.damage-categorize",
      "name": "Damage Categorization",
      "skillFile": "skills/damage-categorize/SKILL.md",
      "domain": "insurance/auto/damage"
    },
    {
      "id": "skill.total-loss-screen",
      "name": "Total-Loss Screening",
      "skillFile": "skills/total-loss-screen/SKILL.md",
      "domain": "insurance/auto/damage"
    },
    {
      "id": "skill.repair-band-lookup",
      "name": "Repair Cost Band Lookup",
      "skillFile": "skills/repair-band-lookup/SKILL.md",
      "domain": "insurance/auto/damage"
    },
    {
      "id": "skill.acv-threshold-check",
      "name": "ACV Threshold Check",
      "skillFile": "skills/acv-threshold-check/SKILL.md",
      "domain": "insurance/auto/damage"
    },
    {
      "id": "skill.shop-match",
      "name": "Shop Match (Category + Make)",
      "skillFile": "skills/shop-match/SKILL.md",
      "domain": "insurance/auto/damage"
    },
    {
      "id": "skill.shop-capacity-balance",
      "name": "Shop Capacity Balance",
      "skillFile": "skills/shop-capacity-balance/SKILL.md",
      "domain": "insurance/auto/damage"
    }
  ],
  "tools": [
    {
      "id": "tool.claim-store",
      "name": "Claim Store",
      "mcpEndpoint": "mcp://localhost/claim-store",
      "auth": {
        "kind": "entra-managed-identity"
      },
      "backendComponent": "cosmos-db"
    },
    {
      "id": "tool.vehicle-lookup",
      "name": "Vehicle Lookup",
      "mcpEndpoint": "mcp://localhost/vehicle-lookup",
      "auth": {
        "kind": "api-key-stub"
      },
      "backendComponent": "duck-creek-stub"
    },
    {
      "id": "tool.policy-store",
      "name": "Policy Store",
      "mcpEndpoint": "mcp://localhost/policy-store",
      "auth": {
        "kind": "api-key-stub"
      },
      "backendComponent": "duck-creek-stub"
    },
    {
      "id": "tool.decision-journal",
      "name": "Decision Journal (RTI)",
      "mcpEndpoint": "mcp://localhost/decision-journal",
      "auth": {
        "kind": "entra-managed-identity"
      },
      "backendComponent": "fabric-bronze"
    }
  ],
  "contextBindings": [
    {
      "intent": "assess_damage",
      "dimensions": [
        "entity",
        "historical",
        "procedural"
      ],
      "latencyTier": "warm",
      "sourceBindings": {
        "FabricIQ": [
          "similar-claims",
          "severity-distribution-by-state"
        ],
        "WorkIQ": [
          "damage-photo-thread"
        ]
      }
    },
    {
      "intent": "estimate_repair",
      "dimensions": [
        "entity",
        "historical",
        "procedural"
      ],
      "latencyTier": "warm",
      "sourceBindings": {
        "FabricIQ": [
          "vehicle-history",
          "incident-type-mix-by-state"
        ],
        "WorkIQ": [
          "shop-collab-history"
        ]
      }
    },
    {
      "intent": "route_shop",
      "dimensions": [
        "entity",
        "procedural",
        "collaboration"
      ],
      "latencyTier": "warm",
      "sourceBindings": {
        "FabricIQ": [
          "policyholder-history"
        ],
        "WorkIQ": [
          "shop-relationship-signal"
        ]
      }
    }
  ],
  "decisionJournal": {
    "eventHubTopic": "adp-v1-decisions",
    "provenanceTagging": {
      "defaultOrigin": "DERIVED"
    },
    "rtiTable": "adp.rti.decisions",
    "bronzeTable": "adp.bronze.decisions"
  }
}
