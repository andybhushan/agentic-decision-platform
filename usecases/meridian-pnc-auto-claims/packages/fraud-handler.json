          "siu-consult-channel"
        ]
      }
    },
    {
      "intent": "analyze_fraud_patterns",
      "dimensions": [
        "historical",
        "entity"
      ],
      "latencyTier": "warm",
      "sourceBindings": {
        "FabricIQ": [
          "similar-claims",
          "hour-of-day-concentration",
          "incident-type-mix-by-state"
        ],
        "WorkIQ": [
          "siu-consult-channel"
        ]
      }
    },
    {
      "intent": "verify_fraud_signal",
      "dimensions": [
        "entity",
