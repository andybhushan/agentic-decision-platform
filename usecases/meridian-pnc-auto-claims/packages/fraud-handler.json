    },
    {
      "id": "skill.siu-investigator-match",
      "name": "SIU Investigator Match",
      "skillFile": "skills/siu-investigator-match/SKILL.md",
      "domain": "insurance/auto/fraud"
    },
    {
      "id": "skill.regulatory-notification-window",
      "name": "Regulatory Notification Window",
      "skillFile": "skills/regulatory-notification-window/SKILL.md",
      "domain": "insurance/auto/fraud"
    }
  ],
  "tools": [
