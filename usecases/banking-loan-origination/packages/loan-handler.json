      }
    }
  ],
  "decisionJournal": {
    "eventHubTopic": "adp-v1-decisions",
    "provenanceTagging": {
      "defaultOrigin": "DERIVED"
    },
    "rtiTable": "adp.rti.decisions",
    "bronzeTable": "adp.bronze.decisions"
  }
}
