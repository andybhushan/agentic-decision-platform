# Application
NODE_ENV=development
PORT=3000

# Azure Blob Storage (Evidence uploads)
# Set to 'mock' or leave empty for local disk storage
AZURE_STORAGE_CONNECTION_STRING=mock
EVIDENCE_CONTAINER_NAME=fnol-evidence

# Azure AI Vision (Evidence image analysis) — uses Foundry endpoint
FOUNDRY_VISION_DEPLOYMENT=gpt-4o

# Cosmos DB (Digital Steward - claims RAG)
COSMOS_STEWARD_CONNECTION_STRING=mock
COSMOS_STEWARD_DATABASE=agent-workflow-builder
COSMOS_STEWARD_CLAIMS_CONTAINER=claim-chunks
COSMOS_STEWARD_CONVERSATIONS_CONTAINER=conversations

# Embedding Model (Digital Steward)
STEWARD_EMBEDDING_MODEL=mock

# CORS
CORS_ORIGIN=http://localhost:5173

# GitHub Executive Reporting
GITHUB_TOKEN=
GITHUB_PROJECT_OWNER=IBM-Project-Imagine
GITHUB_PROJECT_NUMBER=1

# Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-name
FOUNDRY_API_KEY=
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.4
FOUNDRY_PROJECT_NAME=

# Voice layer (web intake agent). Speech<->text via Azure AI Foundry / MAI only.
# Leave the STT/TTS deployments blank to use the built-in mock provider (silent audio,
# canned transcript) so the build/demo stays operable. Set VOICE_PROVIDER=mock to force it.
FOUNDRY_STT_DEPLOYMENT=
FOUNDRY_TTS_DEPLOYMENT=
FOUNDRY_TTS_VOICE=alloy
# VOICE_PROVIDER=mock

# ── Azure Cosmos DB (audit persistence) ──────────────────────────────────────
# Leave blank to run in JSON fallback mode (interactions logged to console only).
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DB_NAME=project-imagine

# ── Azure AI Search (semantic retrieval) ─────────────────────────────────────
# Leave blank to disable vector search (audit writes still work via Cosmos).
AISEARCH_ENDPOINT=https://your-search.search.windows.net
AISEARCH_KEY=
# Agent-interaction telemetry/audit index (provision with `npm run provision:search`).
AISEARCH_INDEX_NAME=agent-interactions
# Digital Steward claims RAG index — separate schema/purpose from the index above.
# Provision with `npm run provision:claims-search`.
AISEARCH_CLAIMS_INDEX_NAME=claims-chunks
# Digital Steward SOP (Standard Operating Procedure) controls index.
# Provision with `npm run provision:sop-search`.
AISEARCH_SOP_INDEX_NAME=sop-chunks

# Embedding model (must be deployed in your Foundry project or Azure OpenAI resource).
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Session Authentication (demo) ────────────────────────────────────────────
# Session secret for express-session (change in production)
SESSION_SECRET=your-session-secret-change-in-production

# ── Entra ID (Microsoft Graph integration) ──────────────────────────────────
# Leave blank to disable Entra integration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── A365 / M365 (Governance signals) ────────────────────────────────────────
# Fall back to Entra credentials if not set
A365_TENANT_ID=
A365_CLIENT_ID=
A365_CLIENT_SECRET=